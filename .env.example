# ============================================================
# Agent-RS Environment Variables
# ============================================================
# Copy this file to .env and fill in the values

# ===================
# Required - Secrets
# ===================

# Database Configuration (PostgreSQL)
# For local development: localhost:5432
# For docker-compose.dev.yml: uses host.docker.internal automatically
DATABASE_URL=postgresql://user:password@localhost:5432/glance_mind

# Database credentials (used by docker-compose.dev.yml)
POSTGRES_USER=aihub_user
POSTGRES_PASSWORD=aihub_password
POSTGRES_DB=aihub_db

# TikHub API Configuration
TIKHUB_API_KEY=your_tikhub_api_key_here

# Facebook RapidAPI Configuration
# Required only when processing Facebook campaigns
FACEBOOK_RAPIDAPI_KEY=your_facebook_rapidapi_key_here

# AI/LLM Configuration (DeepSeek OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ===================
# Optional - Have Defaults
# ===================

# Redis Configuration (for task queue)
# Use host.docker.internal to connect to host machine's Redis (same as scheduler)
REDIS_URL=redis://host.docker.internal:6379/0

# Redis Queue Name (must match scheduler's queue)
# Default: crawler:task_queue
# AGENT_QUEUE_NAME=crawler:task_queue

# TikHub Base URL (default: https://api.tikhub.io)
TIKHUB_BASE_URL=https://api.tikhub.io

# Facebook RapidAPI host and base URL
FACEBOOK_RAPIDAPI_HOST=facebook-scraper3.p.rapidapi.com
FACEBOOK_RAPIDAPI_BASE_URL=https://facebook-scraper3.p.rapidapi.com

# DeepSeek service settings (OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Logging (default: info,glance_mind_agent_rs=debug)
RUST_LOG=info,glance_mind_agent_rs=debug

# ===================
# Concurrency (Optional - All have defaults)
# ===================

# Max concurrent tasks (default: 5)
# AGENT_MAX_CONCURRENT_TASKS=5

# Max concurrent videos per task (default: 5)
# AGENT_MAX_CONCURRENT_VIDEOS=5

# AI API concurrency (default: 20)
# AGENT_AI_CONCURRENCY=20

# TikHub API concurrency (default: 3)
# AGENT_TIKHUB_CONCURRENCY=3

# AI min interval between calls in ms (default: 50)
# AGENT_AI_MIN_INTERVAL_MS=50
