# ============================================================
# Agent-RS Environment Variables
# ============================================================
# Copy this file to .env and fill in the values

# ===================
# Required - Secrets
# ===================

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/glance_mind

# TikHub API Configuration
TIKHUB_API_KEY=your_tikhub_api_key_here

# AI/LLM Configuration (SiliconFlow/OpenAI compatible)
# Use AGENT_API_KEY (preferred) or OPENAI_API_KEY
AGENT_API_KEY=your_ai_api_key_here

# ===================
# Optional - Have Defaults
# ===================

# Redis Configuration (for task queue)
# With network_mode: host, use 127.0.0.1 directly
REDIS_URL=redis://127.0.0.1:6379/0

# Redis Queue Name (must match scheduler's queue)
# Default: crawler:task_queue
# AGENT_QUEUE_NAME=crawler:task_queue

# TikHub Base URL (default: https://api.tikhub.io)
TIKHUB_BASE_URL=https://api.tikhub.io

# AI Service Base URL (default: https://api.siliconflow.cn/v1)
# Use AGENT_BASE_URL (preferred) or OPENAI_BASE_URL
AGENT_BASE_URL=https://api.siliconflow.cn/v1

# AI Model (default: deepseek-ai/DeepSeek-V3)
# AI_MODEL=deepseek-ai/DeepSeek-V3

# Logging (default: info,glance_mind_agent_rs=debug)
RUST_LOG=info,glance_mind_agent_rs=debug

# ===================
# Concurrency (Optional - All have defaults)
# ===================

# Max concurrent tasks (default: 5)
# AGENT_MAX_CONCURRENT_TASKS=5

# Max concurrent videos per task (default: 5)
# AGENT_MAX_CONCURRENT_VIDEOS=5

# AI API concurrency (default: 20)
# AGENT_AI_CONCURRENCY=20

# TikHub API concurrency (default: 3)
# AGENT_TIKHUB_CONCURRENCY=3

# AI min interval between calls in ms (default: 50)
# AGENT_AI_MIN_INTERVAL_MS=50
