# =============================================================================
# GlanceMind Agent-rs E2E Test Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# =============================================================================

# ==================== Required API Keys ====================
# TikHub API (https://tikhub.io)
TIKHUB_API_KEY=your_tikhub_api_key_here

# OpenAI API (or compatible: SiliconFlow, DeepSeek, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# ==================== API Settings ====================
# TikHub base URL
TIKHUB_BASE_URL=https://api.tikhub.io

# OpenAI base URL
# Default: https://api.openai.com/v1
# SiliconFlow: https://api.siliconflow.cn/v1
# DeepSeek: https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# AI Model
AI_MODEL=deepseek-ai/DeepSeek-V3

# ==================== Database Settings ====================
# PostgreSQL
POSTGRES_USER=aihub_user
POSTGRES_PASSWORD=aihub_password
POSTGRES_DB=aihub_e2e_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ==================== Redis Settings ====================
REDIS_HOST=localhost
REDIS_PORT=6380

# ==================== Scheduler Settings ====================
# Optional: Video generation API (leave empty to disable)
LAOZHANG_API_KEY=
CHAT_API_KEY=

# ==================== Agent-rs Settings ====================
# Worker concurrency
AGENT_WORKERS=1
# Queue name (must match scheduler)
AGENT_QUEUE_NAME=crawler:task_queue

# ==================== Test Settings ====================
# E2E Test user ID
E2E_USER_ID=99999
# E2E Test campaign ID
E2E_CAMPAIGN_ID=99901
# Test timeout in seconds
E2E_TIMEOUT=300

# ==================== Logging ====================
# Rust log level (info, debug, trace)
RUST_LOG=info,glance_mind_agent_rs=debug,glance_mind_scheduler=debug
