# =============================================================================
# GlanceMind Agent-rs E2E Test Environment Variables
# =============================================================================
# Copy this file to .env and fill in your API keys
# cp .env.example .env
# =============================================================================

# ==================== Required API Keys ====================
# TikHub API key. E2E docker-compose defaults to the internal tikhub-mock service.
TIKHUB_API_KEY=mock-tikhub-key

# Facebook RapidAPI (used by Facebook real API tests or overridden by mocks in E2E)
FACEBOOK_RAPIDAPI_KEY=your_facebook_rapidapi_key_here

# AI API (DeepSeek OpenAI-compatible)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==================== API Settings ====================
# TikHub base URL. Keep the mock default for deterministic E2E runs.
TIKHUB_BASE_URL=http://tikhub-mock:8500

# Facebook RapidAPI host/base URL
FACEBOOK_RAPIDAPI_HOST=facebook-scraper3.p.rapidapi.com
FACEBOOK_RAPIDAPI_BASE_URL=https://facebook-scraper3.p.rapidapi.com

# AI API settings (agent-rs defaults to DeepSeek; E2E can override to an internal OpenAI-compatible mock)
DEEPSEEK_BASE_URL=http://laozhang-mock:8100/v1
DEEPSEEK_MODEL=deepseek-chat

# ==================== Database Settings ====================
# PostgreSQL
POSTGRES_USER=aihub_user
POSTGRES_PASSWORD=aihub_password
POSTGRES_DB=aihub_e2e_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ==================== Redis Settings ====================
REDIS_HOST=localhost
REDIS_PORT=6380

# ==================== Scheduler Settings ====================
# Optional: Video generation API (leave empty to disable)
LAOZHANG_API_KEY=

# ==================== Agent-rs Settings ====================
# Worker concurrency
AGENT_WORKERS=1
# Queue name (must match scheduler)
AGENT_QUEUE_NAME=crawler:task_queue

# ==================== Test Settings ====================
# E2E Test user ID
E2E_USER_ID=99999
# E2E Test campaign ID
E2E_CAMPAIGN_ID=99901
# Test timeout in seconds
E2E_TIMEOUT=300

# ==================== Logging ====================
# Rust log level (info, debug, trace)
RUST_LOG=info,glance_mind_agent_rs=debug,glance_mind_scheduler=debug
